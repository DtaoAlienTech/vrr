# Copy to .env and replace every CHANGE_ME. Never commit .env.
ENV=dev

POSTGRES_DB=vrr
POSTGRES_USER=vrr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://vrr:CHANGE_ME@127.0.0.1:5433/vrr

# Long random value: login tokens, CSRF tokens and 2FA secrets are all derived from it. At least 32
# characters in production. Changing it signs everybody out and invalidates stored 2FA secrets.
SECRET_KEY=CHANGE_ME

# Comma separated host names the API accepts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Largest photo or PDF that staff may upload, in megabytes
MAX_UPLOAD_MB=10

# 1 = add the starter content when the database is empty (Docker start-up)
SEED_ON_START=1

# Frontend
SITE_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# Cache refresh hook between backend and frontend (internal network only)
REVALIDATE_URL=http://127.0.0.1:3000/internal/revalidate
REVALIDATE_SECRET=CHANGE_ME

# Enquiry form (all optional; enquiries are always saved in the database)
ENQUIRY_TO_EMAIL=
ENQUIRY_RATE_LIMIT_PER_HOUR=5
# Cloudflare Turnstile secret. Leave empty to disable the spam check (development).
TURNSTILE_SECRET=
# Outgoing email for enquiry notifications. Check it with:
#   docker compose exec backend python -m app.cli send-test-email
# Gmail / Microsoft / most providers: port 587 + starttls (an "app password", not the normal one).
# Port 465 needs SMTP_SECURITY=ssl. To try it without an account, see README: "Try the enquiry email".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# How many reverse proxies are in front of the API (0 locally; the Docker setup sets 1)
TRUSTED_PROXY_HOPS=0

# Cloudflare Turnstile site key (public). Used when the frontend image is built.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
