# Copy to .env and replace every CHANGE_ME. Never commit .env.
ENV=dev

POSTGRES_DB=vrr
POSTGRES_USER=vrr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://vrr:CHANGE_ME@127.0.0.1:5433/vrr

# Long random value used to sign tokens (Phase 1).
SECRET_KEY=CHANGE_ME

# Comma separated host names the API accepts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend
SITE_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# Cache refresh hook between backend and frontend (internal network only)
REVALIDATE_URL=http://127.0.0.1:3000/internal/revalidate
REVALIDATE_SECRET=CHANGE_ME

# Enquiry form (all optional; enquiries are always saved in the database)
ENQUIRY_TO_EMAIL=
ENQUIRY_RATE_LIMIT_PER_HOUR=5
# Cloudflare Turnstile secret. Leave empty to disable the spam check (development).
TURNSTILE_SECRET=
# Outgoing email for enquiry notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# true only behind our own reverse proxy (production)
TRUST_PROXY=false
