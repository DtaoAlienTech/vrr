# The single entry point. In production the address below becomes the real domain
# (for example vrrcollege.in) and Caddy gets the HTTPS certificate by itself (Phase 5).
:8080 {
	encode zstd gzip

	# "handle" blocks are tried top to bottom and only the first match runs, so the order matters.

	# The cache-refresh hook is for the backend only, never for the internet.
	handle /internal/* {
		respond 404
	}

	# Caddy overwrites X-Forwarded-For with the real visitor address, so visitors cannot fake it.
	# Uploads may be large (keep this a little above MAX_UPLOAD_MB); every other request body is small.
	handle /api/v1/admin/media* {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:8000
	}
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8000
	}

	# Uploaded photos and PDFs: served straight from the shared volume, cached for a year (file
	# names never repeat), and never allowed to run anything.
	handle /uploads/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'"
	}

	handle {
		reverse_proxy frontend:3000
	}

	header -Server
}
